pipeline{
    agent any

    stages {
        stage("Tofu-init"){
            steps {
                withCredentials([
                    string(credentialsId: 'infracost-api-key', variable: 'INFRACOST_API_KEY'),
                    file(credentialsId: 'ssh-private-key', variable: 'SSH_PRIVATE_KEY'),
                    file(credentialsId: 'ssh-public-key', variable: 'SSH_PUBLIC_KEY'),
                    file(credentialsId: 'gcp-api-key', variable: 'GCP_KEY_FILE')
                ]){
                    sh '''
                    cd $WORKSPACE/iac-pipeline
                    dagger call tofu-init --src=$WORKSPACE/iac/gcloud \
                    --gcp-paas=$WORKSPACE/iac/gcp-paas \
                    --infracost-api-key=env:INFRACOST_API_KEY \
                    --ssh-private-key=env:SSH_PRIVATE_KEY \
                    --ssh-public-key=env:SSH_PUBLIC_KEY \
                    --gcp-sa-key=file:$GCP_KEY_FILE \
                    --output ../envs_cost_report
                    '''
                }
            }
        }
        stage("Tofu-apply"){
            steps{
                withCredentials([
                    string(credentialsId: 'infracost-api-key', variable: 'INFRACOST_API_KEY'),
                    file(credentialsId: 'ssh-private-key', variable: 'SSH_PRIVATE_KEY'),
                    file(credentialsId: 'ssh-public-key', variable: 'SSH_PUBLIC_KEY'),
                    file(credentialsId: 'gcp-api-key', variable: 'GCP_KEY_FILE')
                ]){
                    sh '''
                    cd $WORKSPACE/iac-pipeline
                    dagger call tofu-apply-cheapest --src=$WORKSPACE/iac/gcloud 
                    --gcp-paas=$WORKSPACE/iac/gcp-paas \
                    --costs-json=$WORKSPACE/Plan_Cost_Deploy/envs_cost_report/costs.json \
                    --gcp-sa-key=file:$GCP_KEY_FILE \
                    --ssh-private-key=env:SSH_PRIVATE_KEY \
                    --ssh-public-key=env:SSH_PUBLIC_KEY \
                    --output ../deployment \
                    --deployment-id="$(date +%s)"
                    '''
                }
            }
        }
    }
}